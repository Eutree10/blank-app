# Copy to .streamlit/secrets.toml and fill in.
# Strava application credentials: https://www.strava.com/settings/api
STRAVA_CLIENT_ID = ""
STRAVA_CLIENT_SECRET = ""
STRAVA_REDIRECT_URI = "http://localhost:8501"

# Optional. Without it the coach answers from rules over your own data
# instead of holding an open conversation.
ANTHROPIC_API_KEY = ""
